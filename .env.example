# OpenRouter API key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Models (OpenRouter model slugs)
ACTOR_MODEL=z-ai/glm-5.2
VERIFIER_MODEL=z-ai/glm-5.2

# Bounded termination
MAX_TURNS=30
MAX_COST_USD=2.00
MAX_WALL_CLOCK_SECONDS=3600

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE=https://github.com/cclawton/react-harness
OPENROUTER_APP_NAME=react-harness
