# OpenRouter API key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Models (OpenRouter model slugs)
ACTOR_MODEL=z-ai/glm-5.2
VERIFIER_MODEL=openai/gpt-4o-mini

# Bounded termination
MAX_TURNS=30
MAX_COST_USD=2.00
MAX_WALL_CLOCK_SECONDS=3600

# Independent final verification after verifier approval
FINAL_TEST_COMMAND=python -m pytest -q
FINAL_TEST_TIMEOUT=300

# API retry behaviour
API_RETRIES=3
API_RETRY_BASE_SECONDS=1.0

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE=https://github.com/cclawton/react-harness
OPENROUTER_APP_NAME=react-harness
